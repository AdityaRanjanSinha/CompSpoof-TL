# data & large artifacts (regenerable / huge — never commit)
data/*
!data/.gitkeep
outputs/
checkpoints/
*.flac
*.pt
*.ckpt
*.tar.gz
*.tar.gz.part_*

# Ignore intermediate experiment audios and working dirs
arijit_partial_spoof/
samples_audio/
amgr_status_screenshot.png
arijit_share_pack.zip

# Allow clean demo and share pack audios
!web_demo/audio/*.wav
!web_demo/downloads/*.zip
!share_packs/arijit_f5_inpainting/audio/*.wav
!share_packs/arijit_f5_inpainting/*.zip

# python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
env/

# hugging face cache
.cache/
hf_cache/

# lockfile is committed, but the resolved env dir is not
conda-meta/

# os / editor
.DS_Store
.idea/
.vscode/
*.swp
*.o[0-9]*
